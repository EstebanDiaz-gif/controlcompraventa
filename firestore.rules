rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function memberPath(sid) {
      return /databases/$(database)/documents/stores/$(sid)/members/$(request.auth.uid);
    }
    function isMember(sid) { return signedIn() && exists(memberPath(sid)); }
    function isAdmin(sid) { return isMember(sid) && get(memberPath(sid)).data.role == 'admin'; }
    // Puede cargar productos: administrador, o empleado al que el dueño le activó "cp" en Equipo.
    function canLoad(sid) { return isMember(sid) && (get(memberPath(sid)).data.role == 'admin' || get(memberPath(sid)).data.get('cp', false) == true); }

    // Propietario de la plataforma: su documento en platform_owners se crea a mano desde la consola de Firebase.
    function isPlatformOwner() {
      return signedIn() && (request.auth.uid in ['MgqYIhoyV2gHVluyQBtz8A3LZsw1', 'w2jqVcijMyOytIdFqw2lPhPxQxr1']
        || exists(/databases/$(database)/documents/platform_owners/$(request.auth.uid)));
    }
    // Estado de la suscripción de la tienda. Si la tienda no tiene documento de acceso, funciona sin límite de tiempo.
    function accessPath(sid) { return /databases/$(database)/documents/stores/$(sid)/billing/access; }
    // Catálogo público: solo si la tienda lo activó (stores/{sid}/public/info con enabled = true).
    function catalogOn(sid) {
      return exists(/databases/$(database)/documents/stores/$(sid)/public/info)
        && get(/databases/$(database)/documents/stores/$(sid)/public/info).data.enabled == true;
    }
    // Los almacenes guardan el costo dentro del stock, así que su catálogo NO lee el stock:
    // lee la lista de precios resumida (public/lista_*), que no tiene costos.
    function catalogReadsStock(sid) {
      return catalogOn(sid)
        && get(/databases/$(database)/documents/stores/$(sid)/public/info).data.get('alm', false) != true;
    }

    // Turnos online: la tienda los activa desde la app (stores/{sid}/public/agenda con on = true).
    function agendaOn(sid) {
      return exists(/databases/$(database)/documents/stores/$(sid)/public/agenda)
        && get(/databases/$(database)/documents/stores/$(sid)/public/agenda).data.get('on', false) == true;
    }
    // Turno pedido por un cliente desde el catálogo (sin cuenta): solo campos conocidos y con tamaño acotado,
    // y tiene que reservar en el mismo paso su primer bloque de 15 minutos (ver ocupado).
    function turnoWebOk(sid, id) {
      let t = request.resource.data;
      return t.keys().hasOnly(['id', 'd', 'e', 'en', 'i', 'f', 'sv', 'sn', 'p', 'cl', 'tel', 'src', 'st', 'at'])
        && t.keys().hasAll(['id', 'd', 'e', 'i', 'f', 'sv', 'sn', 'cl', 'tel', 'src', 'st'])
        && t.sv is string && t.sv.size() <= 128 && t.sn is string && t.sn.size() <= 80
        && (!('en' in t) || (t.en is string && t.en.size() <= 60))
        && (!('p' in t) || t.p is number)
        && t.id == id && t.src == 'web' && t.st == 'ok'
        && t.d is string && t.d.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
        && t.i is int && t.f is int && t.i >= 0 && t.f > t.i && t.f - t.i <= 600 && t.f <= 1440
        && t.e is string && t.e.size() > 0 && t.e.size() <= 128
        && t.cl is string && t.cl.size() > 0 && t.cl.size() <= 60
        && t.tel is string && t.tel.size() >= 6 && t.tel.size() <= 20
        && existsAfter(/databases/$(database)/documents/stores/$(sid)/ocupado/$(t.d + '_' + t.e + '_' + string(t.i)));
    }

    // Sucursales: la "familia" de una tienda es su principal (stores/{sid}.main) o ella misma.
    function famOf(s) { return get(/databases/$(database)/documents/stores/$(s)).data.get('main', s); }
    function trPath(sid, tr) { return /databases/$(database)/documents/stores/$(sid)/traspasos/$(tr); }
    // Un movimiento de stock ligado a un envío entre sucursales que queda registrado en la misma escritura.
    function trOk(sid, tr) {
      return tr is string && existsAfter(trPath(sid, tr))
        && ((getAfter(trPath(sid, tr)).data.st == 'recibido' && getAfter(trPath(sid, tr)).data.to == sid)
          || (getAfter(trPath(sid, tr)).data.st == 'cancelado' && getAfter(trPath(sid, tr)).data.from == sid));
    }
    function accessOk(sid) {
      return !exists(accessPath(sid))
        || get(accessPath(sid)).data.unlimited == true
        || (get(accessPath(sid)).data.activeUntil != null && get(accessPath(sid)).data.activeUntil > request.time);
    }

    // Datos de la primera versión de la app (solo el dueño de la cuenta)
    match /users/{uid}/movs/{id} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    // Lista personal de tiendas de cada persona
    match /users/{uid}/stores/{sid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Códigos de invitación cortos (4 caracteres): llevan a una tienda o sucursal puntual.
    // Se consultan de a uno (sabiendo el código), no se pueden listar. Los crea y borra un administrador de esa tienda.
    match /codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.matches('^[A-Z0-9]{4}$')
        && request.resource.data.keys().hasOnly(['sid', 'iid', 'role', 'created', 'exp'])
        && request.resource.data.role in ['admin', 'empleado']
        && isAdmin(request.resource.data.sid)
        && getAfter(/databases/$(database)/documents/stores/$(request.resource.data.sid)/invites/$(request.resource.data.iid)).data.role == request.resource.data.role;
      allow delete: if signedIn() && isAdmin(resource.data.sid);
    }

    // Marca de propietario: cada persona solo puede consultar SU documento. Nadie lo escribe desde la app.
    match /platform_owners/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }

    // Vendedores de Pekeron (instaladores): cualquiera con sesión puede comprobar un código al crear su tienda;
    // la lista completa y los cambios, solo el propietario de la plataforma.
    match /vendedores/{code} {
      allow get: if signedIn();
      allow list, write: if isPlatformOwner();
    }
    // Panel del vendedor. El propietario le manda un link con una clave (vendClaves/{código}); con esa clave
    // el vendedor vincula su cuenta (vendUid/{uid} = {code}) y la clave se borra en el mismo paso.
    function vendCodeOf() { return get(/databases/$(database)/documents/vendUid/$(request.auth.uid)).data.code; }
    function isVendOf(c) {
      return signedIn() && c is string && c != ''
        && exists(/databases/$(database)/documents/vendUid/$(request.auth.uid)) && vendCodeOf() == c;
    }
    match /vendClaves/{code} {
      allow read, write: if isPlatformOwner();
      allow delete: if signedIn()
        && getAfter(/databases/$(database)/documents/vendUid/$(request.auth.uid)).data.code == code;
    }
    match /vendUid/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isPlatformOwner());
      allow list, delete: if isPlatformOwner();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'clave', 'email', 'at'])
        && request.resource.data.clave is string && request.resource.data.clave.size() == 6
        && exists(/databases/$(database)/documents/vendClaves/$(request.resource.data.code))
        && get(/databases/$(database)/documents/vendClaves/$(request.resource.data.code)).data.clave == request.resource.data.clave;
    }

    // Tema de temporada general (para todas las tiendas). Lo lee cualquiera, también el catálogo.
    // Solo el propietario de la plataforma lo activa o lo quita.
    match /platform/tema {
      allow get: if true;
      allow create, update: if isPlatformOwner() && request.resource.data.keys().hasOnly(['tema', 'hasta', 'at', 'off']);
      allow delete: if isPlatformOwner();
    }

    // Links con el nombre de la tienda (pekeronapp.com/minombre): slugs/{nombre} → {sid}.
    // Cualquiera lo lee (para abrir el catálogo). Solo un administrador de esa tienda lo crea o lo borra.
    // Nadie lo puede pisar: así cada nombre pertenece a una sola tienda.
    match /slugs/{slug} {
      allow get: if true;
      allow create: if signedIn()
        && slug.matches('^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$')
        && request.resource.data.keys().hasOnly(['sid', 'at'])
        && isAdmin(request.resource.data.sid);
      allow delete: if isAdmin(resource.data.sid);
    }

    match /stores/{sid} {
      // El vendedor que trajo la tienda ve sus datos básicos (nombre, alta), no lo de adentro.
      allow read: if isMember(sid) || isPlatformOwner() || isVendOf(resource.data.get('vend', ''));
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow update: if (isAdmin(sid) && request.resource.data.owner == resource.data.owner)
        || (isPlatformOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vend']));
      allow delete: if isPlatformOwner();

      match /members/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin(sid) || isPlatformOwner());
        allow create: if signedIn() && (
          isAdmin(sid)
          || (request.auth.uid == uid
              && request.resource.data.role == 'admin'
              && getAfter(/databases/$(database)/documents/stores/$(sid)).data.owner == request.auth.uid)
          || (request.auth.uid == uid
              && exists(/databases/$(database)/documents/stores/$(sid)/invites/$(request.resource.data.code))
              && get(/databases/$(database)/documents/stores/$(sid)/invites/$(request.resource.data.code)).data.role == request.resource.data.role
              && request.resource.data.get('cp', false) == false)
        );
        allow update: if isAdmin(sid);
        allow delete: if isAdmin(sid)
          && uid != get(/databases/$(database)/documents/stores/$(sid)).data.owner;
      }

      // Estado de la suscripción: lo ven los miembros; solo el propietario de la plataforma lo modifica.
      match /billing/{doc} {
        allow read: if isMember(sid) || isPlatformOwner()
          || (doc == 'access' && isVendOf(get(/databases/$(database)/documents/stores/$(sid)).data.get('vend', '')));
        // Al crear la tienda, quien la crea puede iniciar SU prueba gratuita (máximo 15 días, sin pago registrado).
        allow create: if isPlatformOwner() || (signedIn()
          && getAfter(/databases/$(database)/documents/stores/$(sid)).data.owner == request.auth.uid
          && request.resource.data.paidPlan == null
          && request.resource.data.paidUntilMs == null
          && request.resource.data.unlimited == false
          && request.resource.data.activeUntil != null
          && request.resource.data.activeUntil <= request.time + duration.value(15, 'd')
          && request.resource.data.chosenPlan in ['inicial', 'profesional', 'empresarial']);
        allow update, delete: if isPlatformOwner();
      }

      match /invites/{code} {
        allow read, write: if isAdmin(sid);
      }

      // Compras y ventas: solo los administradores las leen.
      // Un empleado solo puede agregar ventas a su nombre.
      match /movs/{id} {
        allow read: if isAdmin(sid);
        allow create: if accessOk(sid) && (isAdmin(sid)
          || (isMember(sid)
              && request.resource.data.t == 'v'
              && request.resource.data.by == request.auth.uid
              && request.resource.data.k in ['mayor', 'menor'])
          // Envíos entre sucursales: salida (ts) al despachar, entrada (te) al recibir o cancelar.
          || (isMember(sid)
              && request.resource.data.t in ['ts', 'te']
              && request.resource.data.by == request.auth.uid
              && request.resource.data.tr is string
              && existsAfter(trPath(sid, request.resource.data.tr))));
        allow update, delete: if isAdmin(sid) && accessOk(sid);
      }

      // Servicios (lista de precios e insumos) y configuración de comisiones y formas de pago:
      // los ven todos los de la tienda; solo un administrador los modifica.
      match /servicios/{id} {
        allow read: if isMember(sid);
        allow write: if isAdmin(sid) && accessOk(sid);
      }
      match /cfg/{doc} {
        allow read: if isMember(sid);
        allow write: if isAdmin(sid) && accessOk(sid);
      }
      // Atenciones: el administrador ve todas; cada empleado puede crear y ver solo las suyas.
      match /atenciones/{id} {
        allow read: if isAdmin(sid) || (isMember(sid) && resource.data.by == request.auth.uid);
        allow create: if accessOk(sid) && (isAdmin(sid) || (isMember(sid) && request.resource.data.by == request.auth.uid));
        allow update, delete: if isAdmin(sid) && accessOk(sid);
      }

      // Gastos del local: solo los administradores.
      match /gastos/{id} {
        allow read: if isAdmin(sid);
        allow write: if isAdmin(sid) && accessOk(sid);
      }

      // Datos públicos de la tienda (nombre, WhatsApp, reglas del catálogo) y lista de precios
      // del catálogo del almacén (public/lista, lista_d0…, lista_i0…). Los ve cualquiera; solo un administrador los cambia.
      match /public/{doc} {
        allow read: if true;
        allow write: if isAdmin(sid) || (canLoad(sid) && doc.matches('^foto_.*'));
      }

      // Stock: lo ven todos los de la tienda.
      // Un empleado solo puede bajar la cantidad, no cambiar nada más.
      // Envíos de mercadería entre sucursales de la misma familia. La ficha se guarda en las dos sucursales.
      match /traspasos/{id} {
        allow read: if isMember(sid);
        allow create: if signedIn()
          && request.resource.data.id == id
          && isMember(request.resource.data.from)
          && request.resource.data.from != request.resource.data.to
          && (sid == request.resource.data.from || sid == request.resource.data.to)
          && famOf(request.resource.data.from) == famOf(request.resource.data.to)
          && request.resource.data.st == 'enviado'
          && request.resource.data.by == request.auth.uid;
        allow update: if signedIn()
          && resource.data.st == 'enviado'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'rat', 'rby', 'rbn', 'rec', 'cat', 'cby', 'cbn'])
          && ((request.resource.data.st == 'recibido' && isMember(resource.data.to))
            || (request.resource.data.st == 'cancelado' && isMember(resource.data.from)));
        allow delete: if isAdmin(sid);
      }

      // Envíos a domicilio: cualquiera del equipo los anota al vender; lo que se le debe a cada repartidor lo ve y lo paga el administrador.
      match /envios/{id} {
        allow read: if isAdmin(sid);
        allow create: if isMember(sid) && accessOk(sid) && request.resource.data.by == request.auth.uid;
        allow update, delete: if isAdmin(sid);
      }

      // Costo de compra de cada producto (id = el del stock). Solo lo ve el equipo: el stock lo lee el catálogo público.
      match /costos/{id} {
        allow read: if isMember(sid);
        allow create, update: if accessOk(sid) && (canLoad(sid)
          || (isMember(sid) && trOk(sid, request.resource.data.get('tr', ''))));
        allow delete: if isAdmin(sid);
      }
      match /stock/{id} {
        allow read: if isMember(sid) || catalogReadsStock(sid);
        allow create: if accessOk(sid) && (canLoad(sid)
          || (isMember(sid) && trOk(sid, request.resource.data.get('tr', ''))));
        allow delete: if isAdmin(sid) && accessOk(sid);
        allow update: if accessOk(sid) && (canLoad(sid)
          || (isMember(sid)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['q'])
              && request.resource.data.q < resource.data.q)
          || (isMember(sid)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['q', 'c', 'tr'])
              && request.resource.data.get('tr', '') != resource.data.get('tr', '')
              && trOk(sid, request.resource.data.get('tr', ''))));
      }

      // ---------------- Turnos (servicios con agenda) ----------------
      // Los datos del cliente (nombre, WhatsApp) solo los ve el equipo de la tienda.
      match /turnos/{id} {
        allow read: if isMember(sid);
        allow create: if (isMember(sid) && accessOk(sid)) || (agendaOn(sid) && turnoWebOk(sid, id));
        allow update, delete: if isMember(sid);
      }
      // Bloques de 15 minutos ocupados: {día}_{profesional}_{minuto}. Sin datos del cliente: los lee el catálogo
      // para mostrar los horarios libres. Nadie puede pisar un bloque que ya existe (no hay "update"):
      // así dos reservas al mismo horario nunca pueden quedar guardadas.
      match /ocupado/{id} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['t', 'd', 'e', 'm'])
          && id == request.resource.data.d + '_' + request.resource.data.e + '_' + string(request.resource.data.m)
          && ((isMember(sid) && accessOk(sid))
              || (agendaOn(sid) && existsAfter(/databases/$(database)/documents/stores/$(sid)/turnos/$(request.resource.data.t))));
        allow delete: if isMember(sid);
      }

      // ---------------- Rubro almacén ----------------
      // Ventas de la caja: el empleado ve solo las suyas; el administrador ve todas y es el único que anula.
      match /ventas/{id} {
        allow read: if isAdmin(sid) || (isMember(sid) && resource.data.by == request.auth.uid);
        allow create: if accessOk(sid) && isMember(sid) && request.resource.data.by == request.auth.uid;
        allow delete: if isAdmin(sid) && accessOk(sid);
      }
      // Compras a proveedores (Reponer): solo administradores.
      match /compras/{id} {
        allow read: if isAdmin(sid);
        allow create: if canLoad(sid) && accessOk(sid);
        allow update, delete: if isAdmin(sid) && accessOk(sid);
      }
      // Totales del mes ya sumados: los suma cualquiera de la tienda al vender; solo el administrador los ve.
      match /totales/{mes} {
        allow read: if isAdmin(sid);
        allow create, update: if isMember(sid) && accessOk(sid);
      }
      // Libreta de fiado: clientes y sus movimientos. Todos anotan; solo el administrador borra.
      match /clientes/{id} {
        allow read: if isMember(sid);
        allow create, update: if isMember(sid) && accessOk(sid);
        allow delete: if isAdmin(sid);
      }
      // Cierre de caja: la caja abierta la ven y la actualizan todos los de la tienda (cada venta suma);
      // una caja ya cerrada solo la puede cambiar un administrador.
      match /cajas/{id} {
        allow read: if isMember(sid);
        allow create: if isMember(sid) && accessOk(sid);
        allow update: if isMember(sid) && accessOk(sid) && (resource.data.get('st', '') == 'open' || isAdmin(sid));
        allow delete: if isAdmin(sid);
      }
      match /fiado/{id} {
        allow read: if isMember(sid);
        allow create: if accessOk(sid) && isMember(sid) && request.resource.data.by == request.auth.uid;
        allow delete: if isAdmin(sid);
      }
    }
  }
}
